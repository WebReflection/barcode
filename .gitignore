# Personal-data fixture (real-world photo) — local only, never commit
# Personal field fixtures (receipt photos etc.) — the WHOLE dir stays local.
packages/web/test-codes/field/

# --- internal dev notes/session log: local only, never public ---
notes/

# --- Python bytecode (never commit) ---
__pycache__/
*.pyc

# --- Micro QR oracle extraction dumps (local-only dev provenance) ---
